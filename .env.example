# Copy this file to .env and fill in your real credentials.
# The .env file is git-ignored; never commit secrets.

# WorldQuant BRAIN credentials
BRAIN_EMAIL=you@example.com
BRAIN_PASSWORD=your-password

# Optional: override API base URL (defaults to https://api.worldquantbrain.com)
# BRAIN_API_BASE=https://api.worldquantbrain.com

# Optional: parallel simulation limit (default 3, conservative for new accounts)
# BRAIN_MAX_PARALLEL=3
